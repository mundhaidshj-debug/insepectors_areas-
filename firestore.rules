rules_version = '2';

// يسمح بالقراءة والكتابة فقط لمن يفتح النظام (تسجيل دخول مجهول تلقائي)
service cloud.firestore {
  match /databases/{database}/documents {
    match /system/{docId} {
      allow read, write: if request.auth != null;
    }

    match /drafts/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
